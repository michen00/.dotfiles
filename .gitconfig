[user]
	email = michael.chen@element.com
	name = Michael I Chen
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJQhzLieT9B4JxZ1QnI01aP4Wg+oKNjd6/qL8xCxOch+
[init]
	defaultBranch = main
[core]
	editor = code --wait
[pull]
	rebase = true
[alias]
	tree = log --graph --decorate --pretty=oneline --abbrev-commit
[rerere]
	enabled = true

[gpg]
	format = ssh

[commit]
	gpgsign = true
[push]
	default = simple
	autoSetupRemote = true
